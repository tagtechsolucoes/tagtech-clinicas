# Copie para deploy/.env e preencha. Este arquivo nunca vai para o Git.

# Endereços (o DNS de cada um aponta para o IP fixo do servidor).
SITE_HOST=agendar.seudominio.com.br
EQUIPE_HOST=app.seudominio.com.br
# E-mail para o Let's Encrypt avisar sobre certificados.
ACME_EMAIL=voce@seudominio.com.br

# Senhas do banco. Gere com: openssl rand -base64 32 | tr -d '/+=' | head -c 32
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# E-mail (troca de senha). Crie a conta no Resend e verifique o domínio.
RESEND_API_KEY=
MAIL_FROM=TagTech Clínicas <nao-responda@seudominio.com.br>

# Monitoramento de erros (opcional, recomendado). DSN do projeto no Sentry.
SENTRY_DSN=

# Versão para os relatórios de erro (o deploy.sh preenche com o commit).
APP_VERSION=
