# HTTPS automático (Let's Encrypt) para os dois endereços. Basta o DNS apontar para o servidor.
{
	email {$ACME_EMAIL}
}

(comum) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# A API fica atrás de /api nos dois sites: mesma origem, sem CORS, cookies simples.
	handle_path /api/* {
		reverse_proxy api:3000
	}
}

# Site de agendamento da clínica e links do paciente.
{$SITE_HOST} {
	import comum
	handle {
		reverse_proxy web-cliente:3001
	}
}

# Painel da equipe. Política de conteúdo estrita: só código do próprio painel roda aqui
# (os documentos para imprimir também herdam esta política).
{$EQUIPE_HOST} {
	import comum
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	handle /assets/* {
		root * /srv/equipe
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Rotas do app (/convite/..., /redefinir/..., /cadastro) caem no index.html.
	handle {
		root * /srv/equipe
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
