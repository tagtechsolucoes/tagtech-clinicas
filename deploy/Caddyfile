# HTTPS automático (Let's Encrypt) para os dois endereços. Basta o DNS apontar para o servidor.
{
	email {$ACME_EMAIL}
}

(comum) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# A API fica atrás de /api nos dois sites: mesma origem, sem CORS, cookies simples.
	# O WebSocket do tempo real (/api/ws) passa por aqui também.
	handle_path /api/* {
		reverse_proxy api:3000
	}
}

# Cardápio do cliente: o que o QR e o link da loja abrem.
{$SITE_HOST} {
	import comum
	handle {
		reverse_proxy web-cliente:3001
	}
}

# App da equipe: cozinha, salão, painel, tablet, convites e troca de senha.
{$EQUIPE_HOST} {
	import comum
	handle /assets/* {
		root * /srv/equipe
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Rotas do app (/convite/..., /redefinir/..., /cadastro) caem no index.html.
	handle {
		root * /srv/equipe
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
